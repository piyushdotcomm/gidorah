{
  "name": "gidorah",
  "version": "0.1.0",
  "description": "The governed coding agent: OpenTUI terminal UI, Bifrost model plane, Tavily knowledge plane, audit chain and receipts.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.4.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "node scripts/lint.ts",
    "typecheck": "node scripts/typecheck.ts",
    "test": "node scripts/run-tests.ts",
    "gidorah": "node apps/cli/src/main.ts",
    "demo": "node apps/cli/src/main.ts demo",
    "bench": "node apps/cli/src/main.ts bench",
    "conformance": "node apps/cli/src/main.ts conformance",
    "chaos": "node apps/cli/src/main.ts chaos",
    "doctor": "node apps/cli/src/main.ts doctor",
    "pack:npm": "node scripts/pack-npm.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tar": "^7.5.22",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.80.7",
    "@opentui/core": "0.8.2"
  },
  "bin": {
    "gidorah": "./bin/gidorah.js"
  },
  "files": [
    "bin",
    "dist",
    "config",
    "tests/replay/demo.jsonl",
    "LICENSE",
    "NOTICE",
    "README.md",
    "third_party/*.LICENSE"
  ],
  "keywords": [
    "coding-agent",
    "tui",
    "opentui",
    "bifrost",
    "tavily",
    "ai",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
