# Gidorah environment. Names only, no values. Copy to .env and fill locally.
# .env is gitignored; secrets never enter the session log, traces, or tests.

# Bifrost gateway (model plane: the only model egress)
BIFROST_BASE_URL=http://127.0.0.1:8080/openai
BIFROST_VK_CLOUD=
BIFROST_VK_LOCAL=

# Provider key lives in Bifrost configuration, not in the Gidorah process.
DEEPSEEK_API_KEY=

# Tavily (knowledge plane; hard-disabled in confidential mode)
TAVILY_API_KEY=

# Local model runtime for confidential mode
OLLAMA_URL=http://127.0.0.1:11434

# Gidorah runtime
GIDORAH_HOME=~/.gidorah
GIDORAH_USER=
GIDORAH_LOG_LEVEL=info

# Mock mode: no external calls, deterministic tests/demo (default when no keys)
GIDORAH_MODE=mock
