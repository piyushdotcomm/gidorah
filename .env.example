# Gidorah environment. Names only, no values. Copy to .env and fill locally.
# .env is gitignored; secrets never enter the session log, traces, or tests.
# Provider keys live in BIFROST, not in Gidorah. See config/bifrost/.env.bifrost.example.

# Bifrost gateway (model plane: the only model egress)
BIFROST_BASE_URL=http://127.0.0.1:8080/openai
BIFROST_VK_CLOUD=
BIFROST_VK_LOCAL=
BIFROST_VK_BENCH=

# Tavily (knowledge plane; hard-disabled in confidential mode)
TAVILY_API_KEY=

# Local model runtime for confidential mode
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Gidorah runtime
GIDORAH_HOME=~/.gidorah
GIDORAH_USER=
GIDORAH_LOG_LEVEL=info

# Mock mode: no external calls, deterministic tests/demo (default when no keys)
GIDORAH_MODE=mock

# Real gateway runs: provider-qualified model alias and an output cap.
# GIDORAH_MODEL_ALIAS=fireworks/accounts/fireworks/models/deepseek-v4p1-flash
# GIDORAH_MAX_TOKENS=1500

# Benchmark: runs per task/arm and step cap (also --runs / --max-steps)
# GIDORAH_BENCH_RUNS=3
# GIDORAH_BENCH_MAX_STEPS=20
